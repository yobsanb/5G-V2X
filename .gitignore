# Datasets and run artifacts. Leading slashes anchor these to the repo root so they
# cannot swallow same-named package directories such as v2x_edge/data/.
/data/
/outputs/*
!/outputs/.gitkeep
/calibration/*.npy
!/calibration/.gitkeep
*.pt
*.pth
*.onnx
*.mp4
*.avi
*.mkv

